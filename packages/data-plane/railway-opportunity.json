{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "RAILPACK",
    "buildCommand": "corepack enable && pnpm install --frozen-lockfile && pnpm --filter @publisheriq/data-plane... build",
    "dockerfilePath": null,
    "watchPatterns": [
      "/packages/data-plane/**",
      "/packages/shared/**",
      "/package.json",
      "/pnpm-lock.yaml",
      "/pnpm-workspace.yaml",
      "/tsconfig.json",
      "/turbo.json"
    ]
  },
  "deploy": {
    "startCommand": "pnpm --filter @publisheriq/data-plane opportunity-worker",
    "healthcheckPath": null,
    "healthcheckTimeout": null,
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 10
  }
}
