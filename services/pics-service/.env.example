# Legacy Supabase targets only. The durable intake path never reads or writes
# Supabase; product ingestion remains Tiger/R2-primary.
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_SERVICE_KEY=eyJ...

# Optional: route PICS change-history rows to Tiger/R2.
PICS_CHANGE_HISTORY_TARGET=tiger
PICS_CHANGE_HISTORY_TIGER_URL=postgresql://...

# Optional: route PICS latest-state app/relationship/sync cursor writes to Tiger.
PICS_LATEST_STATE_TARGET=tiger
PICS_LATEST_STATE_TIGER_URL=postgresql://...

TIGER_PRIMARY_URL=postgresql://...
CHANGE_INTEL_ARCHIVE_TARGET=object_storage
CHANGE_INTEL_ARCHIVE_BUCKET=publisheriq-change-intel-archive
CHANGE_INTEL_ARCHIVE_PREFIX=production/change-intel
CHANGE_INTEL_ARCHIVE_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
CHANGE_INTEL_ARCHIVE_REGION=auto
CHANGE_INTEL_ARCHIVE_ACCESS_KEY_ID=...
CHANGE_INTEL_ARCHIVE_SECRET_ACCESS_KEY=...
CHANGE_INTEL_ARCHIVE_FORCE_PATH_STYLE=true

# Service mode: "bulk_sync" or "change_monitor"
MODE=change_monitor

# Port for health checks (Railway injects this)
PORT=8080

# Bulk sync options (used when MODE=bulk_sync)
BULK_BATCH_SIZE=200
BULK_REQUEST_DELAY=0.5

# Change monitor options (used when MODE=change_monitor)
# Required and fail-closed. Never restart `legacy` as the production primary.
# Use a unique non-primary stream key and explicit frozen start cursor for the
# first shadow replay. `durable` always uses the canonical `primary` stream.
PICS_WORK_MODE=shadow
PICS_INTAKE_TIGER_URL=postgresql://...
PICS_INTAKE_STREAM_KEY=shadow-2026-07-replay
PICS_INTAKE_LANE=catchup
PICS_SHADOW_START_CHANGE_NUMBER=36631816
PICS_INTAKE_STATEMENT_TIMEOUT_SECONDS=60
PICS_INTAKE_LOCK_TIMEOUT_SECONDS=10
# Fail closed by default. Enable only in a separately approved shadow rollout.
PICS_PROCESSING_ENABLED=false
# PICS_CONSUMER_WORKER_ID=publisheriq-pics-shadow-1
PICS_CONSUMER_LIVE_BATCH_SIZE=40
PICS_CONSUMER_CATCHUP_BATCH_SIZE=10
PICS_CONSUMER_LEASE_SECONDS=300
PICS_CONSUMER_RETRY_BASE_SECONDS=30
PICS_CONSUMER_RETRY_MAX_SECONDS=3600
POLL_INTERVAL=30
PROCESS_BATCH_SIZE=100
MAX_QUEUE_SIZE=10000

# One-time PICS change-history backfill options.
PICS_CHANGE_HISTORY_BACKFILL_DRY_RUN=true
PICS_CHANGE_HISTORY_BACKFILL_BATCH_SIZE=500
# PICS_CHANGE_HISTORY_BACKFILL_LIMIT=1000
PICS_CHANGE_HISTORY_BACKFILL_MIN_ID=0
PICS_CHANGE_HISTORY_BACKFILL_SURFACES=snapshots,events

# Logging
LOG_LEVEL=INFO
LOG_JSON=true
